# Скопіюйте цей файл у backend/.env та заповніть значення. Файл .env НЕ комітьте в git.

# --- ШІ-помічник (обов'язково для чату) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Необов'язково:
# AI_TIMEOUT_SECONDS=30
# AI_RATE_LIMIT_PER_MINUTE=15

# --- Безпека ---
SECRET_KEY=змініть-на-довгий-випадковий-рядок
# Дозволені адреси фронтенду через кому (для продакшну не залишайте *)
CORS_ORIGINS=http://localhost:3000

# --- База даних (за замовчуванням SQLite ./fop_platform.db) ---
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fop_platform

# --- Новини (стрічка в кабінетах) ---
# Статті спеціалістів працюють без налаштувань. Офіційні новини підтягуються зі стрічок RSS/Atom.
# Формат: Назва|https://адреса-стрічки   (кілька — через «;»). Третє поле «all» вимикає відбір за ключовими словами:
#   NEWS_FEEDS=Законодавство України|https://адреса-RSS-стрічки;Інша стрічка|https://адреса|all
# Адресу RSS беріть з офіційного сайту джерела (на zakon.rada.gov.ua — сторінка «Стрічки новин (RSS)»).
# NEWS_FEEDS=
# NEWS_SYNC_MINUTES=180            # як часто оновлювати (0 — вимкнути автооновлення)
# NEWS_MAX_AGE_DAYS=30             # не брати записи старші за N днів
# NEWS_MAX_ITEMS_PER_FEED=40
# NEWS_KEYWORDS=податк,єдин,фоп    # свій список ключових слів для відбору (за замовчуванням — вбудований)
